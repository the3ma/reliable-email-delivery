# Local runtime for the handlers: workers that poll LocalStack queues plus the job CLIs.
#   docker build -f Dockerfile.functions -t email-functions .
#   docker run email-functions                      -> worker-processor (default)
#   docker run email-functions digest -- --segment 3

FROM node:22-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
COPY packages/core/package.json packages/core/
COPY packages/functions/package.json packages/functions/
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY scripts ./scripts
COPY templates ./templates
COPY packages ./packages
RUN node scripts/build-functions.mjs && node scripts/smoke-bundles.mjs

# Bundles are self-contained (SDK, Powertools, nodemailer, templates), so no node_modules here.
FROM node:22-alpine AS runtime
ENV NODE_ENV=production \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false
WORKDIR /app
COPY --from=build --chown=node:node /src/dist/image ./
USER node
ENTRYPOINT ["npm", "run", "--silent"]
CMD ["worker-processor"]
