{
  "name": "@mail/infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK v2 infrastructure for the reliable e-mail delivery pipeline",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "email-delivery": "bin/app.js"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "jest",
    "synth": "cdk synth -c stage=dev -c skipBundling=true",
    "synth:prod": "cdk synth -c stage=prod -c skipBundling=true -c alarmEmail=ops@example.test -c sendingDomain=example.test -c fromAddress=notifications@example.test",
    "cdk": "cdk"
  },
  "dependencies": {
    "aws-cdk-lib": "2.274.0",
    "cdk-nag": "2.38.2",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "aws-cdk": "2.1146.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0"
  }
}
